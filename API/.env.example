# ============================================
# Configuración de OpenRouter API
# ============================================
# Obtén tu API key en: https://openrouter.io/keys
OPENROUTER_API_KEY=sk_live_your_api_key_here

# Información del sitio (opcional, usado por OpenRouter)
SITE_URL=http://localhost:3000
SITE_NAME=Sistema SSP

# ============================================
# Configuración de Base de Datos
# ============================================
# SQLite (desarrollo)
DATABASE_URL=sqlite:///./ssp.db

# PostgreSQL (producción)
# DATABASE_URL=postgresql://user:password@localhost/ssp_db

# ============================================
# Configuración de Seguridad
# ============================================
# Clave secreta para JWT (generar con: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production

# Algoritmo de JWT
ALGORITHM=HS256

# Tiempo de expiración del token (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Configuración de la Aplicación
# ============================================
# Ambiente: development, staging, production
ENVIRONMENT=development

# Debug mode
DEBUG=True

# Host y puerto
HOST=0.0.0.0
PORT=8000

# ============================================
# Configuración de Email (opcional)
# ============================================
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@ssp.edu.mx

# ============================================
# Configuración de Logging
# ============================================
# LOG_LEVEL=INFO
# LOG_FILE=logs/app.log

# ============================================
# Configuración de Cifrado de Datos Sensibles
# ============================================
# Llave maestra activa para cifrado de nuevos datos
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ID de la llave activa (para rotación)
KEY_ID_ACTUAL=key_v1_2024

# Llaves de rotación para descifrar datos antiguos
# Formato: key_id:base64_key,key_id2:base64_key2
# Ejemplo: key_v0_2023:abc123...,key_v1_2024:xyz789...
ROTATION_KEYS=

# Habilitar/deshabilitar cifrado (True/False)
# En desarrollo puede ser False para facilitar debugging
ENCRYPTION_ENABLED=True

